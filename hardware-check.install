pre_install() {
    local product
    product=$(cat /sys/class/dmi/id/product_name 2>/dev/null)

    if [[ "$product" != "Alienware Aurora R12" ]]; then
        echo "WARNING: This package is designed for the Alienware Aurora R12."
        echo "         Detected hardware: ${product:-unknown}"
        echo "         Installation will continue, but fan control may not work correctly."
        echo "         Use at own risk!" 
    fi
}

pre_upgrade() {
    pre_install
}

post_install() {
    echo "The tuned profiles use the alienware-wmi platform profile interface."
    echo "Ensure the module is loaded with the correct options by creating:"
    echo "  /etc/modprobe.d/alienware-wmi.conf"
    echo ""
    echo "Example contents:"
    echo "  options alienware-wmi force_platform_profile=1 force_hwmon=1 force_gmode=1"
    echo ""
    echo "Then regenerate your initramfs:"
    echo "  mkinitcpio -P"
}
